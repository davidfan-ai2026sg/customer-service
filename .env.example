# Copy this file to .env.local for optional integrations.
# Demo needs no secrets.

DATABASE_PATH=data/app.db

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=weiyuan-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

PUBLIC_APP_URL=http://localhost:3000

RESEND_API_KEY=
RESEND_FROM=Weiyuan Foods <onboarding@resend.dev>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=factory-notify@weiyuan-foods.example.com

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
